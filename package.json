{
  "name": "procedural-roguelike",
  "version": "0.1.0",
  "description": "A top-down procedural roguelike — a new world from every seed.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen": "node --experimental-transform-types --no-warnings scripts/gen-check.ts",
    "gen:check": "node --experimental-transform-types --no-warnings scripts/gen-check.ts --check"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
